# ==============================================================================
# NekWave Test Input: 3D PEC Cavity Gaussian Pulse
# This file is a read-only test fixture for regression and unit testing.
# Output is explicitly disabled (output_dir = none) to ensure tests produce no disk artifacts.
# ==============================================================================
elements_x = 24
elements_y = 24
elements_z = 24
order = 6

L_x = 2.0
L_y = 2.0
L_z = 2.0

cfl = auto
dt = auto
num_steps = 200
output_freq = 50
pulse_sigma = 20.0
C0 = 0.0 # Central flux (energy-conserving)
output_dir = none
export_fields = false

# Observation probes defined in relative coordinates in (-0.5, 0.5)
probe_rel = 0.16 0.15 -0.1333
probe_rel = -0.24 0.20 0.1667
probe_rel = 0.08 -0.25 -0.20

