# NekWave Example: NekCEM Canonical 3D Box Periodic Benchmark Case
# Directly loads the 128-element mesh from contrib/NekCEM/tests/3dboxper/3dboxper.rea

mesh = contrib/NekCEM/tests/3dboxper/3dboxper.rea
order = 7
wave_type = 3dboxper

cfl = auto
dt = auto

# Termination criteria (whichever is reached first)
final_time = 20.0
max_steps = 10000

# Diagnostic and snapshot frequencies (independent)
output_frequency = 50     # Console logging and energy history
save_frequency = 10      # Full 3D field snapshot saving (HDF5/VTK)

c0 = 0.0                  # Energy-conserving central flux (zero dissipation)
output_dir = output_3dboxper

export_fields = true
export_format = hdf5
export_continuous_vtk = true
