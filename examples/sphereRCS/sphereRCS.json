{
  "_comment": "NekWave Example: 3D PEC Sphere Scattering (RCS) with UPML Absorbing Boundaries",

  "mesh": {
    "type": "nekcem",
    "file": "meshing/sphereRCS/spherePEC.rea"
  },

  "numerics": {
    "order": 5,
    "cfl": "auto",
    "dt": "auto",
    "c0": 1.0,
    "pml_thickness": 3,
    "pml_order": 3.0,
    "pml_reflect_err": 1.0e-6
  },

  "time": {
    "final_time": 10.0,
    "max_steps": 50000
  },

  "output": {
    "output_frequency": 20,
    "save_frequency": 150,
    "output_dir": "output_sphereRCS",
    "export_fields": true,
    "export_format": "hdf5",
    "export_continuous_vtk": false
  },

  "probes": [
    [-0.8, 0.0, 0.0],
    [ 0.0, 0.8, 0.0],
    [ 0.0, 0.0, 0.8],
    [ 0.8, 0.0, 0.0]
  ]
}
